{
  "expo": {
    "name": "Dealr",
    "slug": "dealr",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "scheme": "dealr",
    "android": {
      "package": "com.dealr.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#378cf6"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "dealrapp.in", "pathPrefix": "/ad" },
            { "scheme": "https", "host": "www.dealrapp.in", "pathPrefix": "/ad" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.dealr.app",
      "associatedDomains": ["applinks:dealrapp.in", "applinks:www.dealrapp.in"],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow access to your camera so you can take photos for your ads.",
        "NSPhotoLibraryUsageDescription": "Allow access to your photos so you can add images to your ads."
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
